{
  "name": "bennett-toolbox",
  "private": true,
  "version": "1.1.2",
  "description": "多功能工具箱桌面应用",
  "author": "李海波 <bennettmail@163.com>",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "e2e run",
    "build:all": "npm run build && npm run build:electron",
    "test:electron": "node tests/electron.full.mjs",
    "test:electron:smoke": "node tests/electron.smoke.mjs",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "gifenc": "^1.0.3",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "e2e": "^0.23.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "build": {
    "appId": "com.bennett.toolbox",
    "productName": "Bennett Toolbox",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Bennett-Toolbox-${version}-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bennett-Toolbox-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
