{
  "name": "bennett-toolbox",
  "private": true,
  "version": "2.0.1",
  "description": "多功能工具箱桌面应用",
  "author": "李海波 <bennettmail@163.com>",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "e2e run",
    "build:all": "npm run build && npm run build:electron",
    "test:unit": "node --test tests/unit/plugins/*.test.mjs",
    "test:plugins": "node tests/plugins.electron.mjs && node tests/plugins.race.electron.mjs",
    "test:mcp": "node --test tests/mcp.pilot.mjs",
    "mcp": "node mcp/server.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:electron": "node tests/electron.full.mjs",
    "test:electron:smoke": "node tests/electron.smoke.mjs",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "setup:markitdown": "sh scripts/setup-markitdown.sh",
    "prepare:markitdown": "node scripts/prepare-markitdown.mjs"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cron-parser": "^5.10.4",
    "diff": "^9.0.0",
    "e2e": "^0.23.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "build": {
    "appId": "com.bennett.toolbox",
    "productName": "Bennett Toolbox",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Bennett-Toolbox-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Bennett Toolbox needs screen recording access to capture screenshots."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bennett-Toolbox-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
